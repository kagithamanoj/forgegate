<APIProxy revision="3" name="petstore">
    <Description>Petstore API proxy, bundled as a Oxvara example</Description>
    <Policies>
        <Policy>Verify-API-Key</Policy>
        <Policy>Spike-Arrest</Policy>
        <Policy>Quota-Pets</Policy>
